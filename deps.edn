{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.clojure/core.async {:mvn/version "1.8.741"}
        datascript/datascript {:mvn/version "1.8.1"}}
 :aliases
 {:run {:main-opts ["-m" "clojurecraft.main"]}
  :rcon {:main-opts ["-m" "clojurecraft.rcon"]}
  :harness {:main-opts ["-m" "clojurecraft.harness"]}
  :gym {:main-opts ["-m" "clojurecraft.gym"]}
  :datagen {:extra-paths ["dev"]
            :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}
            :main-opts ["-m" "clojurecraft.datagen"]}
  :replay {:main-opts ["-m" "clojurecraft.replay"]}
  :brain {:extra-paths ["dev"] :main-opts ["-m" "clojurecraft.brain"]}
  :fmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
        :main-opts ["-m" "cljfmt.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}
          :main-opts ["-m" "nrepl.cmdline"]}}}
