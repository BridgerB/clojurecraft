;; clojure-lsp's settings: shared by every editor that opens the repo, and by the pre-commit hook
;; and CI (scripts/clojure-lsp diagnostics, clean-ns).
{;; a public var nothing calls is dead code: raised from info so the hook and CI refuse it
 ;; `scratch` (an executor's private intent attributes) is read by name through ns-resolve, which the
 ;; analysis cannot see; scratch_test holds it
 :linters {:clojure-lsp/unused-public-var {:level :warning
                                           :exclude-regex #{"clojurecraft\\..*/scratch"}}}
 ;; clean-ns sorts the :require and :import entries and :refer lists, and drops unused ones. The
 ;; layout is zprint's (:keep): zprint hangs a short :require on its line and drops a long one below
 ;; it, and clean-ns forcing either fought the other, so a ns could not grow past 47 requires (main's,
 ;; 2026-11-07); the classes inside one package import are left as written for the same reason. A :refer list
 ;; wraps two columns short of :max-line-length, so 102 is the width zprint's 100 allows.
 :clean {:ns-inner-blocks-indentation :keep
         :sort
         {:ns true :require true :import true :import-classes nil :refer {:max-line-length 102}}}}
