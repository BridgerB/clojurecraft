;; The mobs the server model (sim.clj) runs, as data: read by clojurecraft.mob.

;; Each kind's numbers. :health the game's max health; :box [width height] its hitbox; :speed
;; blocks a tick walking at the player (the movement speed attribute through the ground's friction:
;; a zombie's 0.23 walks 2.3 blocks a second); :follow how near the player must be for it to chase;
;; :melee the damage of one hit on Normal and :every the ticks between hits, :reach how near (feet
;; to feet on the plane) a hit lands; :shoot a ranged hit's damage on Normal, :range how far it
;; shoots with a clear line, :keep how near it walks before it stands to shoot; :fuse a creeper's
;; ticks from swelling to blast, :swell how near the player starts it, :blast the blast's power;
;; :undead burns in daylight under the sky; :neutral attacks only once hurt or stared at; :passive
;; never attacks; :hostile spawns by the night rule, :weight how often among them; :loot [[item lo
;; hi]], each item lo to hi when killed by the player; :paths finds a route round what stops its
;; straight walk (route); :teleports teleports at its target as an enderman does (toward-aim,
;; away-aim). :entity the entity type the client is told when it is not the kind's own name (a
;; magma cube's sizes are kinds of their own); :armour the armour points that take their share of
;; the player's hit (mob/absorbed); :hop how high its jump lifts its feet, so it strikes a player
;; that far over it, the line from its head to the eye clear; :split [kind lo hi], lo to hi of
;; kind where it died.
{:mob/kinds
 {:zombie {:health 20.0
           :box [0.6 1.95]
           :speed 0.115
           :follow 35.0
           :melee 3.0
           :every 20
           :reach 1.4
           :undead true
           :hostile true
           :weight 100
           :loot [[:rotten_flesh 0 2]]}
  :skeleton {:health 20.0
             :box [0.6 1.99]
             :speed 0.137
             :follow 16.0
             :shoot 3.0
             :every 40
             :range 15.0
             :keep 10.0
             :undead true
             :hostile true
             :weight 100
             :loot [[:bone 0 2] [:arrow 0 2]]}
  :creeper {:health 20.0
            :box [0.6 1.7]
            :speed 0.137
            :follow 16.0
            :fuse 30
            :swell 3.0
            :blast 3.0
            :hostile true
            :weight 100
            :loot [[:gunpowder 0 2]]}
  :spider {:health 16.0
           :box [1.4 0.9]
           :speed 0.197
           :follow 16.0
           :melee 2.0
           :every 20
           :reach 1.6
           :hostile true
           :weight 100
           :loot [[:string 0 2]]}
  :enderman {:health 40.0
             :box [0.6 2.9]
             :speed 0.197
             :follow 64.0
             :melee 7.0
             :every 20
             :reach 1.4
             :neutral true
             :hostile true
             :weight 10
             :paths true
             :teleports true
             :loot [[:ender_pearl 0 1]]}
  :blaze {:health 20.0
          :box [0.6 1.8]
          :speed 0.2
          :flies true
          :contact 6.0
          :reach 2.0
          :contact-every 20
          :follow 48.0
          :shoot 5.0
          :projectile :fireball
          :ignites 5000
          :volley {:charge 60 :shots 3 :between 6 :rest 100}
          :range 48.0
          :keep 16.0
          :loot [[:blaze_rod 0 1]]}
  ;; a fortress's own hostiles (structure spawn_overrides: wither_skeleton weight 8, magma_cube 3).
  ;; No :weight: the overworld's night rule does not roll them (hostile-kinds). :melee is omitted
  ;; on the magma cube because combat/hit-damage reads it and the bot's line for a magma cube
  ;; stays unknown; its hit is :contact, which only the model strikes with. A magma cube is one of
  ;; three sizes, each a kind told to the client as :magma_cube (MagmaCube.setSize): size s has
  ;; s squared health, a box 0.52 s on a side, armour 3 s, a hit of s + 2 on Normal, a walk of
  ;; 0.2 + 0.1 s (0.11 a tick at size 2), and a jump of 0.42 + 0.1 s a tick, which lifts the feet
  ;; 1.84, 2.52 and 4.15 blocks (gravity 0.08, drag 0.98). One of size 2 or 4 splits where it dies
  ;; into 2 to 4 of half the size (Slime.remove: 2 + nextInt(3)).
  :wither_skeleton {:health 20.0
                    :box [0.7 2.4]
                    :speed 0.137
                    :follow 16.0
                    :melee 8.0
                    :every 20
                    :reach 1.4
                    :wither true
                    :undead true
                    :hostile true
                    :loot [[:bone 0 2] [:coal 0 1]]}
  :magma_cube_small {:entity :magma_cube
                     :health 1.0
                     :box [0.52 0.52]
                     :speed 0.0825
                     :follow 16.0
                     :contact 3.0
                     :every 20
                     :reach 1.1
                     :armour 3
                     :hop 1.84
                     :hostile true}
  :magma_cube {:health 4.0
               :box [1.04 1.04]
               :speed 0.11
               :follow 16.0
               :contact 4.0
               :every 20
               :reach 1.5
               :armour 6
               :hop 2.52
               :split [:magma_cube_small 2 4]
               :hostile true
               :loot [[:magma_cream 0 1]]}
  :magma_cube_big {:entity :magma_cube
                   :health 16.0
                   :box [2.08 2.08]
                   :speed 0.165
                   :follow 16.0
                   :contact 6.0
                   :every 20
                   :reach 2.4
                   :armour 12
                   :hop 4.15
                   :split [:magma_cube 2 4]
                   :hostile true
                   :loot [[:magma_cream 0 1]]}
  :hoglin {:health 40.0
           :box [1.4 1.4]
           :speed 0.15
           :follow 16.0
           :melee 6.0
           :every 20
           :reach 2.0
           :hostile true
           :loot [[:porkchop 2 4]]}
  :ghast {:health 10.0
          :box [4.0 4.0]
          :speed 0.0
          :follow 100.0
          :shoot 6.0
          :every 60
          :range 64.0
          :keep 64.0
          :loot [[:ghast_tear 0 1] [:gunpowder 0 2]]}
  :piglin {:health 16.0
           :box [0.6 1.95]
           :speed 0.115
           :follow 16.0
           :shoot 5.0
           :every 40
           :range 16.0
           :keep 8.0
           :loot []}
  :cow {:health 10.0 :box [0.9 1.4] :passive true :loot [[:beef 1 3] [:leather 0 2]]}
  :pig {:health 10.0 :box [0.9 0.9] :passive true :loot [[:porkchop 1 3]]}
  :sheep {:health 8.0 :box [0.9 1.3] :passive true :loot [[:mutton 1 2] [:white_wool 1 1]]}
  :chicken {:health 4.0 :box [0.4 0.7] :passive true :loot [[:chicken 1 1] [:feather 0 2]]}
  :ender_dragon {:health 200.0 :box [16.0 8.0] :perched true :loot []}
  :end_crystal {:health 1.0 :box [2.0 2.0] :blast 6.0 :crystal true :loot []}}
 ;; :mob/equipment
 ;; {kind {slot item}} what a kind holds when the server shows it (set-equipment, slot names as
 ;; entity/equipment-slots): a skeleton's bow, a wither skeleton's stone sword, a piglin's crossbow.
 ;; A kind not here shows nothing.
 :mob/equipment {:skeleton {:mainhand :bow}
                 :wither_skeleton {:mainhand :stone_sword}
                 :piglin {:mainhand :crossbow}}
 ;; The animals a chunk is given when it is first loaded, in a fixed order.
 :mob/passive [:chicken :cow :pig :sheep]
 ;; The kinds a warped forest's monster list spawns, with their weights: the enderman alone (weight
 ;; 1, in packs of enderman-pack), as vanilla's warped_forest biome lists them. The Nether spawns by
 ;; biome; the model tells a warped forest by its floor (warped-floor?).
 :mob/warped [[:enderman 1]]
 ;; The kinds a fortress's brick floor spawns, with their weights, beside the blaze spawner: wither
 ;; skeleton 8 and magma cube 3, the structure's spawn_overrides (fortress.json), the cube's 3 shared
 ;; evenly by its three sizes (Slime.finalizeSpawn: 1 << nextInt(3)). Blazes stay the spawner's. One
 ;; mob a try, the model's rate, not the structure's minCount.
 :mob/fortress [[:wither_skeleton 8] [:magma_cube_small 1] [:magma_cube 1] [:magma_cube_big 1]]
 ;; The kinds a basalt delta's floor (basalt, blackstone) spawns: vanilla's basalt_deltas monster list
 ;; is the magma cube 100 and the ghast 40; the ghast is left out, as the warped forest's are. The
 ;; three sizes evenly, in packs of mob/deltas-pack.
 :mob/deltas [[:magma_cube_small 1] [:magma_cube 1] [:magma_cube_big 1]]
 ;; The kind a crimson forest's floor spawns: the hoglin, weight 1. Piglins are not modelled.
 :mob/crimson [[:hoglin 1]]}
