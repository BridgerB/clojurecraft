;; The gym's plan file: landing sets. A set's centre sits far from world spawn so gym sites never
;; meet a race region (steve's lesson: spawn gets polluted). n cells, spacing blocks apart, each
;; snapped to the biome; pregen-r blocks are generated around each landing (13x13 = 169 chunks at
;; 96, within one forceload). Changing this file rebuilds the cached world.
{:landing-sets
 {"A" {:center [20000 20000] :n 20 :spacing 640 :biome "#minecraft:is_forest" :pregen-r 96}
  ;; W: shores (issue #5), after steve's landing set W: a bank with swimmable water near it
  "W" {:center [26000 20000] :n 20 :spacing 640 :biome "#minecraft:is_beach" :pregen-r 96}
  ;; R1-R4: the race's worlds (race.yml, :race/landing-sets), each its own seed (kept in its
  ;; level.dat), 48 forest landings 320 apart with 112 blocks pregenerated round each (15x15 = 225
  ;; chunks, one forceload): the same worlds and landings every commit, so races compare landing
  ;; by landing, and no runner's server generates a fresh world round each bot or runs a locate
  ;; biome per bot in one of its ticks.
  "R1" {:seed "race-R1"
        :center [3000 3000]
        :n 48
        :spacing 320
        :biome "#minecraft:is_forest"
        :pregen-r 112}
  "R2" {:seed "race-R2"
        :center [3000 3000]
        :n 48
        :spacing 320
        :biome "#minecraft:is_forest"
        :pregen-r 112}
  "R3" {:seed "race-R3"
        :center [3000 3000]
        :n 48
        :spacing 320
        :biome "#minecraft:is_forest"
        :pregen-r 112}
  "R4" {:seed "race-R4"
        :center [3000 3000]
        :n 48
        :spacing 320
        :biome "#minecraft:is_forest"
        :pregen-r 112}}}
